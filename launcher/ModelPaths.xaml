<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="模型路径设置" Width="850" Height="620" MinWidth="740" MinHeight="550" WindowStartupLocation="CenterOwner" Background="#E7F3E9" FontFamily="Segoe UI" Foreground="#173E32">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="18,10"/><Setter Property="Margin" Value="6,0,0,0"/><Setter Property="Background" Value="#BBE8B5"/><Setter Property="Foreground" Value="#173E32"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="White" BorderThickness="1" CornerRadius="18" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#267557"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="26">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><TextBlock Text="模型路径设置" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="读取其他工具的模型文件夹，不复制、不移动模型；原有目录继续保留。" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
  <Border Grid.Row="1" Background="#AAFFFFFF" CornerRadius="20" Padding="18" Margin="0,0,0,16">
   <StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ComboBox x:Name="TypeSelector" DisplayMemberPath="Label" MinHeight="34" VerticalContentAlignment="Center" AutomationProperties.Name="模型类型"/>
     <Button x:Name="AddPathButton" Grid.Column="1" Content="选择并添加目录"/>
    </Grid>
    <TextBlock x:Name="TypeDescription" Margin="0,12,0,0" TextWrapping="Wrap"/>
    <TextBlock Text="本机默认目录（始终保留）" FontSize="12" Margin="0,12,0,4" Foreground="#416455"/>
    <TextBox x:Name="DefaultPathText" IsReadOnly="True" Background="Transparent" BorderThickness="0" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>
  <DataGrid x:Name="ExternalPathsList" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#99FFFFFF" BorderBrush="White" RowHeight="36" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="外部模型目录">
   <DataGrid.Columns><DataGridTextColumn Header="模型类型" Binding="{Binding type}" Width="150"/><DataGridTextColumn Header="完整目录" Binding="{Binding path}" Width="*" MinWidth="420"/></DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="3" Margin="0,12,0,16"><TextBlock Text="同类可添加多个目录。移除只取消引用，不删除文件；保存后下次启动服务生效。" TextWrapping="Wrap" Foreground="#416455"/><TextBlock Text="共用路径不代表模型兼容：请选择与工作流匹配的模型；同名文件建议改成不同名称。" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#416455"/></StackPanel>
  <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="RemovePathButton" Content="移除选中引用" HorizontalAlignment="Left" Margin="0" Background="#CCFFFFFF"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="CancelPathsButton" Content="取消" Background="#CCFFFFFF" IsCancel="True"/><Button x:Name="SavePathsButton" Content="保存路径"/></StackPanel></Grid>
 </Grid>
</Window>
