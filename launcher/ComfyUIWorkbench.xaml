<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ComfyUI Workbench" Width="1120" Height="760" MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#F4F6FA" FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#172033"/>
    <SolidColorBrush x:Key="Muted" Color="#697386"/>
    <SolidColorBrush x:Key="Line" Color="#E1E6EF"/>
    <SolidColorBrush x:Key="Accent" Color="#635BFF"/>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#635BFF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="22,12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.88"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Foreground" Value="#273248"/>
      <Setter Property="Background" Value="#EEF1F7"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="18,11"/>
    </Style>
    <Style x:Key="CardButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Padding" Value="15,9"/>
      <Setter Property="Margin" Value="0,14,0,0"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="22"/>
    </Style>
  </Window.Resources>

  <Grid Background="#F4F6FA">
    <Grid.RowDefinitions>
      <RowDefinition Height="82"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="White" BorderBrush="#E7EAF0" BorderThickness="0,0,0,1">
      <Grid Margin="34,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="ComfyUI Workbench" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
          <TextBlock Text="本地图片与视频工作站" Margin="0,3,0,0" FontSize="13" Foreground="{StaticResource Muted}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border x:Name="StatusPill" Background="#FFF4D8" CornerRadius="14" Padding="12,6" Margin="0,0,12,0">
            <TextBlock x:Name="StatusText" Text="正在检查" FontSize="13" FontWeight="SemiBold" Foreground="#855F00"/>
          </Border>
          <Button x:Name="ChangeStorageButton" Style="{StaticResource SecondaryButton}" Content="更改存储位置" ToolTip="选择模型、工作流和输出文件保存的位置。"/>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="34,28,34,24">
        <Border CornerRadius="20" Padding="30" Margin="0,0,0,20">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#24213E" Offset="0"/>
              <GradientStop Color="#5149A8" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,28,0">
              <TextBlock x:Name="HeroTitle" Text="从一个工作流开始" FontSize="30" FontWeight="SemiBold" Foreground="White"/>
              <TextBlock x:Name="HeroDescription" Margin="0,10,0,0" MaxWidth="650" TextWrapping="Wrap" FontSize="15" LineHeight="24" Foreground="#E5E3FF"
                         Text="ComfyUI 用节点连接图片或视频的生成步骤。工作台负责环境、文件与启动，你不需要配置 Python。"/>
              <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <Button x:Name="PrimaryActionButton" Style="{StaticResource PrimaryButton}" Background="#FFFFFF" Foreground="#383174" Content="准备工作台"/>
                <Button x:Name="StopButton" Style="{StaticResource SecondaryButton}" Background="#FFFFFF" Content="停止运行" Margin="10,0,0,0" ToolTip="停止由本工作台启动的 ComfyUI 服务，不会删除模型或输出。"/>
              </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="#26FFFFFF" CornerRadius="14" Padding="20">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="当前设备" Foreground="#C9C5FF" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock x:Name="GpuText" Text="正在检测显卡" Margin="0,7,0,0" TextWrapping="Wrap" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                <Border Height="1" Background="#35FFFFFF" Margin="0,16"/>
                <TextBlock Text="存储位置" Foreground="#C9C5FF" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock x:Name="StorageText" Text="—" Margin="0,7,0,0" TextWrapping="Wrap" Foreground="White" FontSize="13"/>
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
            <StackPanel>
              <TextBlock Text="模型与素材" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
              <TextBlock Text="模型决定能生成什么" Margin="0,6,0,0" FontSize="14" FontWeight="SemiBold" Foreground="#635BFF"/>
              <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="{StaticResource Muted}"
                         Text="Checkpoint 是主模型；LoRA 为它增加风格、角色或细节。"/>
              <Button x:Name="ModelLibraryButton" Style="{StaticResource CardButton}" Background="#E8E7FF" Foreground="#4D46B8" Content="浏览并下载模型" ToolTip="从经过审核的 Hugging Face 模型中选择，自动下载并校验文件。"/>
              <Button x:Name="ModelsButton" Style="{StaticResource CardButton}" Margin="0,8,0,0" Content="打开模型文件夹"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0">
            <StackPanel>
              <TextBlock Text="工作流" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
              <TextBlock Text="保存好的一套生成步骤" Margin="0,6,0,0" FontSize="14" FontWeight="SemiBold" Foreground="#635BFF"/>
              <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="{StaticResource Muted}"
                         Text="工作流可以重复运行，也可以在 ComfyUI 中打开并修改节点。"/>
              <Button x:Name="WorkflowsButton" Style="{StaticResource CardButton}" Content="打开工作流文件夹"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}" Margin="10,0,0,0">
            <StackPanel>
              <TextBlock Text="输出管理" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
              <TextBlock Text="查看生成的图片和视频" Margin="0,6,0,0" FontSize="14" FontWeight="SemiBold" Foreground="#635BFF"/>
              <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="{StaticResource Muted}"
                         Text="所有结果保存在本地，不会自动上传到其他服务。"/>
              <Button x:Name="OutputButton" Style="{StaticResource CardButton}" Content="打开输出文件夹"/>
            </StackPanel>
          </Border>
        </Grid>

        <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="20,16">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="工作台状态" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
              <TextBlock x:Name="CountsText" Margin="16,0,0,0" Foreground="{StaticResource Muted}" Text="0 个主模型 · 0 个工作流"/>
            </StackPanel>
            <Button x:Name="DoctorButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="检查问题" ToolTip="检查显卡、磁盘、运行环境和服务端口，并给出修复建议。"/>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Expander x:Name="LogExpander" Grid.Row="2" Header="运行详情" Background="White" BorderBrush="#E1E6EF" BorderThickness="0,1,0,0" Padding="34,12">
      <Grid Height="145" Margin="0,8,0,0">
        <Grid.RowDefinitions><RowDefinition Height="4"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <ProgressBar x:Name="BusyBar" Grid.Row="0" IsIndeterminate="True" Visibility="Collapsed" Foreground="#635BFF"/>
        <TextBox x:Name="LogText" Grid.Row="1" Margin="0,10,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 BorderThickness="0" Background="#F7F8FB" Foreground="#3F4A5E" FontFamily="Consolas" FontSize="12" Padding="12"/>
      </Grid>
    </Expander>
  </Grid>
</Window>
