<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ComfyUI Workbench" Width="1120" Height="760" MinWidth="960" MinHeight="680"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Background="#E4F1E8" FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="82" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#173E32"/>
    <SolidColorBrush x:Key="Muted" Color="#416455"/>
    <SolidColorBrush x:Key="Line" Color="#BFFFFFFF"/>
    <SolidColorBrush x:Key="Accent" Color="#267557"/>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="#173E32"/>
      <Setter Property="Background" Value="#BCEDAD"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#AFFFFFFF"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="22,12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="22" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.86"/><Setter TargetName="Root" Property="BorderBrush" Value="#267557"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="#267557"/><Setter TargetName="Root" Property="BorderThickness" Value="2"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.7"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Foreground" Value="#24533F"/>
      <Setter Property="Background" Value="#60FFFFFF"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="18,11"/>
    </Style>
    <Style x:Key="CardButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Padding" Value="15,9"/>
      <Setter Property="Margin" Value="0,14,0,0"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background">
        <Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#60FFFFFF" Offset="0"/><GradientStop Color="#30FFFFFF" Offset="1"/></LinearGradientBrush></Setter.Value>
      </Setter>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="28"/>
      <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#376D53" BlurRadius="28" ShadowDepth="7" Opacity="0.14"/></Setter.Value></Setter>
      <Setter Property="Padding" Value="22"/>
    </Style>
  </Window.Resources>

  <Grid ClipToBounds="True">
    <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#ECF5DA" Offset="0"/><GradientStop Color="#ACDDC4" Offset="0.53"/><GradientStop Color="#D2EBC8" Offset="1"/></LinearGradientBrush></Grid.Background>
    <Grid.RowDefinitions>
      <RowDefinition Height="82"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Soft-edged colored shapes remain visible through translucent glass surfaces. -->
    <Canvas Grid.RowSpan="3" IsHitTestVisible="False" ClipToBounds="True">
      <Ellipse Width="370" Height="370" Canvas.Left="40" Canvas.Top="10">
        <Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#66CFAB" Offset="0"/><GradientStop Color="#9AE8CE" Offset="1"/></LinearGradientBrush></Ellipse.Fill>
        <Ellipse.Effect><BlurEffect Radius="24"/></Ellipse.Effect>
      </Ellipse>
      <Ellipse Width="290" Height="290" Canvas.Left="770" Canvas.Top="180" Fill="#D5F495">
        <Ellipse.Effect><BlurEffect Radius="26"/></Ellipse.Effect>
      </Ellipse>
      <Ellipse Width="420" Height="420" Canvas.Left="480" Canvas.Top="430">
        <Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#80CFA4" Offset="0"/><GradientStop Color="#B6E7CA" Offset="1"/></LinearGradientBrush></Ellipse.Fill>
        <Ellipse.Effect><BlurEffect Radius="30"/></Ellipse.Effect>
      </Ellipse>
    </Canvas>

    <Border Grid.Row="0" Background="#45FFFFFF" BorderBrush="#BFFFFFFF" BorderThickness="0,0,0,1">
      <Grid Margin="34,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="ComfyUI Workbench" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
          <TextBlock Text="本地图片与视频工作站" Margin="0,3,0,0" FontSize="13" Foreground="{StaticResource Muted}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Border x:Name="StatusPill" Background="#FFF4D8" CornerRadius="14" Padding="12,6" Margin="0,0,12,0">
            <TextBlock x:Name="StatusText" Text="正在检查" FontSize="13" FontWeight="SemiBold" Foreground="#855F00"/>
          </Border>
          <Button x:Name="ChangeStorageButton" Style="{StaticResource SecondaryButton}" Content="更改存储位置" ToolTip="选择模型、工作流和输出文件保存的位置。"/>
          <Button x:Name="MinimizeWindowButton" Style="{StaticResource SecondaryButton}" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Width="32" Height="32" Padding="0" Margin="12,0,4,0" ToolTip="最小化" AutomationProperties.Name="最小化窗口"/>
          <Button x:Name="MaximizeWindowButton" Style="{StaticResource SecondaryButton}" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" Width="32" Height="32" Padding="0" Margin="0,0,4,0" ToolTip="最大化 / 还原" AutomationProperties.Name="最大化或还原窗口"/>
          <Button x:Name="CloseWindowButton" Style="{StaticResource SecondaryButton}" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Width="32" Height="32" Padding="0" ToolTip="关闭启动器" AutomationProperties.Name="关闭启动器"/>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="34,28,34,24">
        <Border CornerRadius="32" Padding="30" Margin="0,0,0,20" BorderBrush="#DDFFFFFF" BorderThickness="1">
          <Border.Effect><DropShadowEffect Color="#376D53" BlurRadius="30" ShadowDepth="9" Opacity="0.17"/></Border.Effect>
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#66FFFFFF" Offset="0"/>
              <GradientStop Color="#25E4FFD8" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,28,0">
              <TextBlock x:Name="HeroTitle" Text="点击下面的按钮打开webui" TextWrapping="Wrap" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
              <TextBlock x:Name="HeroDescription" Margin="0,10,0,0" MaxWidth="650" TextWrapping="Wrap" FontSize="15" LineHeight="24" Foreground="#345B49"
                         Text="本地离线运行的工作站，已完成环境配置和依赖打包"/>
              <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <Button x:Name="PrimaryActionButton" Style="{StaticResource PrimaryButton}" Background="#BCEDAD" Foreground="#173E32" Content="准备工作台"/>
                <Button x:Name="StopButton" Style="{StaticResource SecondaryButton}" Background="#83FFFFFF" Content="停止运行" Margin="10,0,0,0" ToolTip="停止由本工作台启动的 ComfyUI 服务，不会删除模型或输出。"/>
              </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="#45FFFFFF" BorderBrush="#D9FFFFFF" BorderThickness="1" CornerRadius="24" Padding="20">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="当前设备" Foreground="#3C7057" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock x:Name="GpuText" Text="正在检测显卡" Margin="0,7,0,0" TextWrapping="Wrap" Foreground="#173E32" FontSize="15" FontWeight="SemiBold"/>
                <Border Height="1" Background="#AFFFFFFF" Margin="0,16"/>
                <TextBlock Text="存储位置" Foreground="#3C7057" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock x:Name="StorageText" Text="—" Margin="0,7,0,0" TextWrapping="Wrap" Foreground="#345B49" FontSize="13"/>
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
            <StackPanel>
              <TextBlock Text="模型与其他工具" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
              <TextBlock Text="不同的模型生成的质感可能不一样哦" Margin="0,6,0,0" FontSize="14" FontWeight="SemiBold" Foreground="#267557"/>
              <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="{StaticResource Muted}"
                         Text="现在只放了两个我比较喜欢的因为实在太大了不好打包QAQ"/>
              <Button x:Name="ModelLibraryButton" Style="{StaticResource CardButton}" Background="#96D1F2C4" Foreground="#245B41" Content="浏览并下载模型" ToolTip="从经过审核的 Hugging Face 模型中选择，自动下载并校验文件。"/>
              <Button x:Name="ModelsButton" Style="{StaticResource CardButton}" Margin="0,8,0,0" Content="打开模型文件夹"/>
              <Button x:Name="ModelPathsButton" Style="{StaticResource CardButton}" Margin="0,8,0,0" Content="模型路径设置" ToolTip="按模型类型添加其他位置的目录，与其他工具共用模型文件。"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0">
            <StackPanel>
              <TextBlock Text="工作流" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
              <TextBlock Text="可以复用的流程模板" Margin="0,6,0,0" FontSize="14" FontWeight="SemiBold" Foreground="#267557"/>
              <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="{StaticResource Muted}"
                         Text="在webui里面打开的时候找格式是json的打开，没做完可以存起来下次用"/>
              <Button x:Name="WorkflowsButton" Style="{StaticResource CardButton}" Content="打开工作流文件夹"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}" Margin="10,0,0,0">
            <StackPanel>
              <TextBlock Text="输出管理" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
              <TextBlock Text="查看生成的图片和视频" Margin="0,6,0,0" FontSize="14" FontWeight="SemiBold" Foreground="#267557"/>
              <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="{StaticResource Muted}"
                         Text="默认是在这里，但是有可能因为你配置工作流里面显式指定的而产生变化"/>
              <Button x:Name="OutputButton" Style="{StaticResource CardButton}" Content="打开输出文件夹"/>
            </StackPanel>
          </Border>
        </Grid>

        <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="20,16">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="工作台状态" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
              <TextBlock x:Name="CountsText" Margin="16,0,0,0" Foreground="{StaticResource Muted}" Text="0 个主模型 · 0 个工作流"/>
            </StackPanel>
            <Button x:Name="DoctorButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="检查问题" ToolTip="检查显卡、磁盘、运行环境和服务端口，并给出修复建议。"/>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Expander x:Name="LogExpander" Grid.Row="2" Header="运行详情" Foreground="#345B49" Background="#66FFFFFF" BorderBrush="#BFFFFFFF" BorderThickness="0,1,0,0" Padding="34,12">
      <Grid Height="145" Margin="0,8,0,0">
        <Grid.RowDefinitions><RowDefinition Height="4"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <ProgressBar x:Name="BusyBar" Grid.Row="0" IsIndeterminate="True" Visibility="Collapsed" Foreground="#267557"/>
        <TextBox x:Name="LogText" Grid.Row="1" Margin="0,10,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 BorderThickness="0" Background="#96FFFFFF" Foreground="#345B49" FontFamily="Consolas" FontSize="12" Padding="12"/>
      </Grid>
    </Expander>
  </Grid>
</Window>
