<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="模型库 · ComfyUI Workbench" Width="880" Height="620" MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#F4F6FA" FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#172033"/>
    <SolidColorBrush x:Key="Muted" Color="#697386"/>
    <SolidColorBrush x:Key="Line" Color="#E1E6EF"/>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#635BFF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="20,11"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Foreground" Value="#273248"/>
      <Setter Property="Background" Value="#E9EDF5"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="28,22">
      <StackPanel>
        <TextBlock Text="选择一个主模型" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
        <TextBlock Margin="0,6,0,0" Text="模型来自 Hugging Face。工作台只展示已核对来源、许可证、文件大小和哈希的条目。" FontSize="13" Foreground="{StaticResource Muted}"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" Margin="28,24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280"/>
        <ColumnDefinition Width="20"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="8">
        <ListBox x:Name="ModelList" BorderThickness="0" Background="Transparent" DisplayMemberPath="ListLabel"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" FontSize="14" Padding="2"/>
      </Border>

      <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="24">
        <StackPanel>
          <DockPanel LastChildFill="True">
            <Border x:Name="ModelStatusPill" DockPanel.Dock="Right" Background="#EEF1F7" CornerRadius="12" Padding="10,5">
              <TextBlock x:Name="ModelStatusText" Text="尚未下载" FontSize="12" FontWeight="SemiBold" Foreground="#596579"/>
            </Border>
            <TextBlock x:Name="ModelNameText" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
          </DockPanel>
          <TextBlock x:Name="ModelFamilyText" Margin="0,7,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#635BFF"/>
          <TextBlock x:Name="ModelSummaryText" Margin="0,20,0,0" FontSize="14" LineHeight="22" TextWrapping="Wrap" Foreground="#3F4A5E"/>

          <Border Margin="0,20,0,0" Background="#F7F8FB" CornerRadius="10" Padding="15">
            <StackPanel>
              <TextBlock Text="在这台电脑上" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
              <TextBlock x:Name="ModelHardwareText" Margin="0,6,0,0" FontSize="13" LineHeight="20" TextWrapping="Wrap" Foreground="#3F4A5E"/>
            </StackPanel>
          </Border>

          <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="下载大小" FontSize="12" Foreground="{StaticResource Muted}"/>
              <TextBlock x:Name="ModelSizeText" Margin="0,4,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="许可证" FontSize="12" Foreground="{StaticResource Muted}"/>
              <TextBlock x:Name="ModelLicenseText" Margin="0,4,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
            </StackPanel>
          </Grid>
          <TextBlock x:Name="ModelLicenseNoteText" Margin="0,18,0,0" FontSize="12" LineHeight="19" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="28,16">
      <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
          <Button x:Name="ModelSourceButton" Style="{StaticResource SecondaryButton}" Content="查看模型来源"/>
          <Button x:Name="ModelFolderButton" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Content="打开模型文件夹"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="ModelCloseButton" Style="{StaticResource SecondaryButton}" Content="关闭"/>
          <Button x:Name="ModelDownloadButton" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Content="下载并安装"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
